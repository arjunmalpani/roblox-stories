[
 {
  "text": "My head was so gigantic, the fire department had to cut the classroom roof off with a chainsaw just to pull me out!",
  "start": 0.021,
  "end": 4.642,
  "startFrame": 1,
  "endFrame": 139,
  "words": [
   0,
   22
  ]
 },
 {
  "text": "And it was still growing, with twenty students pushing on my forehead!",
  "start": 4.642,
  "end": 7.068,
  "startFrame": 139,
  "endFrame": 212,
  "words": [
   23,
   34
  ]
 },
 {
  "text": "You see, in this world, every time you tell a lie, your head expands by ten percent.",
  "start": 7.047,
  "end": 10.163,
  "startFrame": 211,
  "endFrame": 305,
  "words": [
   35,
   51
  ]
 },
 {
  "text": "And every time you tell the truth, it shrinks back down.",
  "start": 9.899,
  "end": 12.693,
  "startFrame": 297,
  "endFrame": 381,
  "words": [
   52,
   62
  ]
 },
 {
  "text": "That's why nobody ever lies on their homework!",
  "start": 12.672,
  "end": 14.324,
  "startFrame": 380,
  "endFrame": 430,
  "words": [
   63,
   70
  ]
 },
 {
  "text": "Kids walk into school confessing their darkest secrets just to fit through the front door.",
  "start": 14.658,
  "end": 17.983,
  "startFrame": 440,
  "endFrame": 539,
  "words": [
   71,
   85
  ]
 },
 {
  "text": "My dad once lied about doing the dishes and got his head wedged in the refrigerator for two days!",
  "start": 17.983,
  "end": 21.768,
  "startFrame": 539,
  "endFrame": 653,
  "words": [
   86,
   104
  ]
 },
 {
  "text": "My name is Eddie, and I was the most honest kid in town.",
  "start": 21.894,
  "end": 24.361,
  "startFrame": 657,
  "endFrame": 731,
  "words": [
   105,
   117
  ]
 },
 {
  "text": "Until last Tuesday, when I accidentally broke the school's golden trophy with a stray dodgeball!",
  "start": 24.319,
  "end": 28.271,
  "startFrame": 730,
  "endFrame": 848,
  "words": [
   118,
   132
  ]
 },
 {
  "text": "Principal Carl sprinted into the hallway!",
  "start": 28.251,
  "end": 29.735,
  "startFrame": 848,
  "endFrame": 892,
  "words": [
   133,
   138
  ]
 },
 {
  "text": "\"Who smashed the trophy?!\"",
  "start": 29.944,
  "end": 30.99,
  "startFrame": 898,
  "endFrame": 930,
  "words": [
   139,
   142
  ]
 },
 {
  "text": "Panic hit me.",
  "start": 30.969,
  "end": 31.701,
  "startFrame": 929,
  "endFrame": 951,
  "words": [
   143,
   145
  ]
 },
 {
  "text": "\"A raccoon did it!\"",
  "start": 31.617,
  "end": 32.454,
  "startFrame": 949,
  "endFrame": 974,
  "words": [
   146,
   149
  ]
 },
 {
  "text": "I blurted.",
  "start": 32.454,
  "end": 33.018,
  "startFrame": 974,
  "endFrame": 991,
  "words": [
   150,
   151
  ]
 },
 {
  "text": "Poof!",
  "start": 33.06,
  "end": 33.499,
  "startFrame": 992,
  "endFrame": 1005,
  "words": [
   152,
   152
  ]
 },
 {
  "text": "My head swelled to the size of a giant pumpkin!",
  "start": 33.646,
  "end": 35.737,
  "startFrame": 1009,
  "endFrame": 1072,
  "words": [
   153,
   162
  ]
 },
 {
  "text": "Carl narrowed his eyes.",
  "start": 35.653,
  "end": 36.678,
  "startFrame": 1070,
  "endFrame": 1100,
  "words": [
   163,
   166
  ]
 },
 {
  "text": "\"A raccoon in the cafeteria?!\"",
  "start": 36.594,
  "end": 37.911,
  "startFrame": 1098,
  "endFrame": 1137,
  "words": [
   167,
   171
  ]
 },
 {
  "text": "\"Yes!",
  "start": 37.828,
  "end": 38.309,
  "startFrame": 1135,
  "endFrame": 1149,
  "words": [
   172,
   172
  ]
 },
 {
  "text": "And it was wearing a tiny cape!\"",
  "start": 37.828,
  "end": 39.898,
  "startFrame": 1135,
  "endFrame": 1197,
  "words": [
   173,
   179
  ]
 },
 {
  "text": "Boom!",
  "start": 39.501,
  "end": 39.751,
  "startFrame": 1185,
  "endFrame": 1193,
  "words": [
   180,
   180
  ]
 },
 {
  "text": "My head expanded again!",
  "start": 39.501,
  "end": 40.776,
  "startFrame": 1185,
  "endFrame": 1223,
  "words": [
   181,
   184
  ]
 },
 {
  "text": "Now it was the size of a golf cart!",
  "start": 40.943,
  "end": 42.491,
  "startFrame": 1228,
  "endFrame": 1275,
  "words": [
   185,
   193
  ]
 },
 {
  "text": "My neck was wobbling!",
  "start": 42.407,
  "end": 43.453,
  "startFrame": 1272,
  "endFrame": 1304,
  "words": [
   194,
   197
  ]
 },
 {
  "text": "My balance was completely gone!",
  "start": 43.348,
  "end": 44.916,
  "startFrame": 1300,
  "endFrame": 1347,
  "words": [
   198,
   202
  ]
 },
 {
  "text": "\"Eddie, are you lying to me?!\"",
  "start": 44.749,
  "end": 45.753,
  "startFrame": 1342,
  "endFrame": 1373,
  "words": [
   203,
   208
  ]
 },
 {
  "text": "shouted Carl.",
  "start": 46.046,
  "end": 47.112,
  "startFrame": 1381,
  "endFrame": 1413,
  "words": [
   209,
   210
  ]
 },
 {
  "text": "\"No!",
  "start": 46.715,
  "end": 46.903,
  "startFrame": 1401,
  "endFrame": 1407,
  "words": [
   211,
   211
  ]
 },
 {
  "text": "I love honesty!",
  "start": 46.715,
  "end": 47.739,
  "startFrame": 1401,
  "endFrame": 1432,
  "words": [
   212,
   214
  ]
 },
 {
  "text": "Honesty is my middle name!\"",
  "start": 47.928,
  "end": 48.869,
  "startFrame": 1438,
  "endFrame": 1466,
  "words": [
   215,
   219
  ]
 },
 {
  "text": "Bam!",
  "start": 49.078,
  "end": 49.35,
  "startFrame": 1472,
  "endFrame": 1480,
  "words": [
   220,
   220
  ]
 },
 {
  "text": "My head exploded to the size of a minivan, wedging tight between the lockers!",
  "start": 49.078,
  "end": 53.051,
  "startFrame": 1472,
  "endFrame": 1592,
  "words": [
   221,
   234
  ]
 },
 {
  "text": "Kids were screaming!",
  "start": 52.612,
  "end": 53.804,
  "startFrame": 1578,
  "endFrame": 1614,
  "words": [
   235,
   237
  ]
 },
 {
  "text": "Lockers were crumpling like soda cans!",
  "start": 53.385,
  "end": 55.225,
  "startFrame": 1602,
  "endFrame": 1657,
  "words": [
   238,
   243
  ]
 },
 {
  "text": "Carl backed away in horror.",
  "start": 54.995,
  "end": 56.376,
  "startFrame": 1650,
  "endFrame": 1691,
  "words": [
   244,
   248
  ]
 },
 {
  "text": "\"He's going to demolish the entire school!",
  "start": 56.229,
  "end": 58.362,
  "startFrame": 1687,
  "endFrame": 1751,
  "words": [
   249,
   255
  ]
 },
 {
  "text": "Call the SWAT team!\"",
  "start": 57.944,
  "end": 58.989,
  "startFrame": 1738,
  "endFrame": 1770,
  "words": [
   256,
   259
  ]
 },
 {
  "text": "Meanwhile, ceiling tiles were cracking!",
  "start": 59.094,
  "end": 60.704,
  "startFrame": 1773,
  "endFrame": 1821,
  "words": [
   260,
   264
  ]
 },
 {
  "text": "Concrete dust was crumbling down around my ears!",
  "start": 60.641,
  "end": 62.67,
  "startFrame": 1819,
  "endFrame": 1880,
  "words": [
   265,
   272
  ]
 },
 {
  "text": "If I lied one more time, my head would take out the whole building!",
  "start": 62.649,
  "end": 65.179,
  "startFrame": 1879,
  "endFrame": 1955,
  "words": [
   273,
   286
  ]
 },
 {
  "text": "Then I noticed Carl's shiny toupee slipping sideways in the chaos.",
  "start": 65.054,
  "end": 67.772,
  "startFrame": 1952,
  "endFrame": 2033,
  "words": [
   287,
   297
  ]
 },
 {
  "text": "Truth!",
  "start": 67.96,
  "end": 68.357,
  "startFrame": 2039,
  "endFrame": 2051,
  "words": [
   298,
   298
  ]
 },
 {
  "text": "The rule works both ways!",
  "start": 67.96,
  "end": 69.361,
  "startFrame": 2039,
  "endFrame": 2081,
  "words": [
   299,
   303
  ]
 },
 {
  "text": "I took a deep breath and screamed at the top of my lungs: \"I DON'T ACTUALLY LIKE BROCCOLI!\"",
  "start": 69.643,
  "end": 73.021,
  "startFrame": 2089,
  "endFrame": 2191,
  "words": [
   304,
   321
  ]
 },
 {
  "text": "Pop!",
  "start": 73.188,
  "end": 73.543,
  "startFrame": 2196,
  "endFrame": 2206,
  "words": [
   322,
   322
  ]
 },
 {
  "text": "My head shrunk ten percent!",
  "start": 73.188,
  "end": 74.463,
  "startFrame": 2196,
  "endFrame": 2234,
  "words": [
   323,
   327
  ]
 },
 {
  "text": "\"I COPIED LEO'S MATH HOMEWORK IN THIRD GRADE!\"",
  "start": 74.215,
  "end": 77.098,
  "startFrame": 2226,
  "endFrame": 2313,
  "words": [
   328,
   335
  ]
 },
 {
  "text": "Pop!",
  "start": 76.659,
  "end": 77.454,
  "startFrame": 2300,
  "endFrame": 2324,
  "words": [
   336,
   336
  ]
 },
 {
  "text": "Down to beach ball size!",
  "start": 76.659,
  "end": 78.018,
  "startFrame": 2300,
  "endFrame": 2341,
  "words": [
   337,
   341
  ]
 },
 {
  "text": "\"AND PRINCIPAL CARL'S HAIR IS ACTUALLY A CHEAP FAKE WIG!\"",
  "start": 78.144,
  "end": 80.528,
  "startFrame": 2344,
  "endFrame": 2416,
  "words": [
   342,
   351
  ]
 },
 {
  "text": "Pop!",
  "start": 80.507,
  "end": 80.925,
  "startFrame": 2415,
  "endFrame": 2428,
  "words": [
   352,
   352
  ]
 },
 {
  "text": "Pop!",
  "start": 80.507,
  "end": 81.28,
  "startFrame": 2415,
  "endFrame": 2438,
  "words": [
   353,
   353
  ]
 },
 {
  "text": "Pop!",
  "start": 80.852,
  "end": 81.448,
  "startFrame": 2426,
  "endFrame": 2443,
  "words": [
   354,
   354
  ]
 },
 {
  "text": "My head zipped right back to normal size!",
  "start": 81.259,
  "end": 83.581,
  "startFrame": 2438,
  "endFrame": 2507,
  "words": [
   355,
   362
  ]
 },
 {
  "text": "I squeezed loose and hit the floor!",
  "start": 83.476,
  "end": 84.919,
  "startFrame": 2504,
  "endFrame": 2548,
  "words": [
   363,
   369
  ]
 },
 {
  "text": "The entire cafeteria erupted into cheers!",
  "start": 84.814,
  "end": 86.654,
  "startFrame": 2544,
  "endFrame": 2600,
  "words": [
   370,
   375
  ]
 },
 {
  "text": "Carl turned bright red and slapped both hands over his bald head.",
  "start": 86.801,
  "end": 89.54,
  "startFrame": 2604,
  "endFrame": 2686,
  "words": [
   376,
   387
  ]
 },
 {
  "text": "I walked out of school feeling like an absolute champion.",
  "start": 89.456,
  "end": 91.715,
  "startFrame": 2684,
  "endFrame": 2751,
  "words": [
   388,
   397
  ]
 },
 {
  "text": "Until my mom called my phone.",
  "start": 91.715,
  "end": 92.844,
  "startFrame": 2751,
  "endFrame": 2785,
  "words": [
   398,
   403
  ]
 },
 {
  "text": "\"Eddie, did you eat the last chocolate cupcake?\"",
  "start": 93.137,
  "end": 94.935,
  "startFrame": 2794,
  "endFrame": 2848,
  "words": [
   404,
   411
  ]
 },
 {
  "text": "I looked at the phone.",
  "start": 94.935,
  "end": 95.688,
  "startFrame": 2848,
  "endFrame": 2871,
  "words": [
   412,
   416
  ]
 },
 {
  "text": "\"No, Mom.\"",
  "start": 95.813,
  "end": 96.671,
  "startFrame": 2874,
  "endFrame": 2900,
  "words": [
   417,
   418
  ]
 },
 {
  "text": "Boing!",
  "start": 96.775,
  "end": 97.674,
  "startFrame": 2903,
  "endFrame": 2930,
  "words": [
   419,
   419
  ]
 }
]